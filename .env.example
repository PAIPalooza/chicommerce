# Database settings
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/zerocommerce

# API settings
API_V1_STR=/api/v1
SECRET_KEY=your-secret-key-here

# Redis settings (for caching)
REDIS_URL=redis://localhost:6379/0

# Security settings
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Admin settings
ADMIN_API_KEY=your-admin-api-key-here

# TLS/HTTPS settings
TLS_ENABLED=true
HTTPS_REDIRECT_ENABLED=true
SECURITY_HEADERS_ENABLED=true
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=false

# S3 settings (for preview storage)
S3_ACCESS_KEY=your-s3-access-key
S3_SECRET_KEY=your-s3-secret-key
S3_BUCKET=your-s3-bucket
S3_REGION=your-s3-region

# Log level
LOG_LEVEL=INFO

# AINative Authentication & ZeroDB
AINATIVE_API_URL=https://api.ainative.studio/
AINATIVE_API_TOKEN=kLPiP0bzgKJ0CnNYVt1wq3qxbs2QgDeF2XwyUnxBEOM
AINATIVE_USERNAME=admin@ainative.studio
AINATIVE_PASSWORD=Admin2025!Secure
ZERODB_PROJECT_ID=your-project-id-here

# ZeroDB PostgreSQL (filled automatically by provision_zerodb_postgres.py)
ZERODB_HOST=your-zerodb-host
ZERODB_PORT=5432
ZERODB_DATABASE=your-zerodb-database
ZERODB_USERNAME=your-zerodb-username
ZERODB_PASSWORD=your-zerodb-password
ZERODB_URL=postgresql+psycopg2://username:password@host:port/database
ZERODB_TIMEOUT=30
ZERODB_MAX_RETRIES=3
